# --- Choix du fournisseur gratuit : gemini | groq | openrouter ---
LLM_PROVIDER=gemini

# Mets UNE clé (celle du fournisseur choisi) :
#   Gemini     -> https://aistudio.google.com/apikey        (1500 req/j, sans CB)
#   Groq       -> https://console.groq.com/keys             (très rapide, ~30 req/min)
#   OpenRouter -> https://openrouter.ai/keys                (large choix de modèles :free)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optionnel : forcer un modèle précis (sinon défaut par fournisseur)
# LLM_MODEL=gemini-2.5-flash

# --- Optionnel : source NVD (CVE par produit) ---
# Marche sans clé (5 req/30s). Une clé gratuite monte à 50 req/30s :
#   https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Production uniquement (voir DEPLOY.md) ---
# Comptes par passkeys : le PREMIER compte créé est l'admin. Sur l'URL publique,
# ce premier enregistrement exige ce mot de passe comme "code d'amorçage"
# (empêche un inconnu de rafler l'admin). Ensuite l'admin invite les autres.
# CARDINAL_PASSWORD=
# WebAuthn (passkeys). En prod, défauts dérivés de CARDINAL_URL. En LOCAL :
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5000
# Clé de session stable : python3 -c "import secrets; print(secrets.token_hex(32))"
# CARDINAL_SECRET_KEY=
# Démarre la veille auto sous gunicorn (inutile en local) :
# CARDINAL_SCHEDULER=1
# URL publique (liens cliquables dans les notifications push ntfy) :
# CARDINAL_URL=https://cardinal.aguetai.fr
